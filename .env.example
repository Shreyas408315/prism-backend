# PRism Backend Server Port
PORT=3000

# Local PostgreSQL connection (optional for development)
DATABASE_URL=postgresql://prism:prism_dev_password@localhost:5432/prism

# Standalone Python Origin Model Service URL
# Local development:
ML_SERVICE_URL=http://localhost:8000

# Render Cloud Private Network (for cloud deployment):
# ML_SERVICE_URL=http://prism-origin-model:8000

# Request timeout in milliseconds (default: 4000ms)
ML_SERVICE_TIMEOUT_MS=4000
